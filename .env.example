# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (Project Settings → API Keys / Connect) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # or the legacy "anon" key
SUPABASE_SECRET_KEY=sb_secret_...                          # or the legacy "service_role" key — server only
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- AI ---
ANTHROPIC_API_KEY=sk-ant-...
# Haiku 5.5 + low effort is the default (cheap). Sonnet 5.5 / higher effort give richer research at several times the cost.
RADAR_MODEL=anthropic/claude-haiku-5-5
RADAR_FAST_MODEL=anthropic/claude-haiku-5-5
RADAR_EFFORT=low

# --- Second Opinion (calibrated scoring, TypeSafe "jev" model) via Vercel AI Gateway — optional ---
AI_GATEWAY_API_KEY=
# TYPESAFE_API_KEY=   # optional, only if you have a direct TypeSafe account
